---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Registro - PowerGym">
  <main class="flex items-center justify-center min-h-screen bg-gray-100">
    <form class="bg-white p-8 rounded-xl shadow-md w-full max-w-md space-y-4" method="POST" id="registerForm">
      
      <!-- Título -->
      <h1 class="text-[26px] font-bold text-center text-black leading-tight">
        Registro de <span class="text-[#88CE02] underline">Usuario</span>
      </h1>

      <!-- Nombre -->
      <div>
        <label for="nombre" class="block text-sm font-semibold text-black mb-1">Nombre:</label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          placeholder="Ingrese su nombre"
          class="w-full px-3 py-2"
          style="background-color: #F2F2F2; border: 1px solid #D1D5DB; border-radius: 5px; box-shadow: 0px 4px 4px 0px #00000040;"
        />
      </div>

      <!-- Apellido -->
      <div>
        <label for="apellido" class="block text-sm font-semibold text-black mb-1">Apellido:</label>
        <input
          type="text"
          id="apellido"
          name="apellido"
          placeholder="Ingrese su apellido"
          class="w-full px-3 py-2"
          style="background-color: #F2F2F2; border: 1px solid #D1D5DB; border-radius: 5px; box-shadow: 0px 4px 4px 0px #00000040;"
        />
      </div>

      <!-- Fecha de nacimiento -->
      <div>
        <label for="fecha" class="block text-sm font-semibold text-black mb-1">Fecha de nacimiento:</label>
        <input
          type="date"
          id="fecha"
          name="fecha"
          class="w-full px-3 py-2"
          style="background-color: #F2F2F2; border: 1px solid #D1D5DB; border-radius: 5px; box-shadow: 0px 4px 4px 0px #00000040;"
        />
      </div>

      <!-- Dirección -->
      <div>
        <label for="direccion" class="block text-sm font-semibold text-black mb-1">Dirección:</label>
        <input
          type="text"
          id="direccion"
          name="direccion"
          placeholder="Ingrese su dirección"
          class="w-full px-3 py-2"
          style="background-color: #F2F2F2; border: 1px solid #D1D5DB; border-radius: 5px; box-shadow: 0px 4px 4px 0px #00000040;"
        />
      </div>

      <!-- Email -->
      <div>
        <label for="email" class="block text-sm font-semibold text-black mb-1">Email:</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Ingrese su correo electrónico"
          class="w-full px-3 py-2"
          style="background-color: #F2F2F2; border: 1px solid #D1D5DB; border-radius: 5px; box-shadow: 0px 4px 4px 0px #00000040;"
        />
      </div>

      <!-- Teléfono -->
      <div>
        <label for="telefono" class="block text-sm font-semibold text-black mb-1">Teléfono:</label>
        <input
          type="tel"
          id="telefono"
          name="telefono"
          placeholder="Ingrese su teléfono"
          class="w-full px-3 py-2"
          style="background-color: #F2F2F2; border: 1px solid #D1D5DB; border-radius: 5px; box-shadow: 0px 4px 4px 0px #00000040;"
        />
      </div>

      <!-- Contraseña -->
      <div>
        <label for="password" class="block text-sm font-semibold text-black mb-1">Contraseña:</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Cree una contraseña"
          class="w-full px-3 py-2"
          style="background-color: #F2F2F2; border: 1px solid #D1D5DB; border-radius: 5px; box-shadow: 0px 4px 4px 0px #00000040;"
        />
      </div>

      <!-- Botón -->
      <div class="flex justify-center">
        <button
          type="submit"
          style="
          background-color: #8DC90E;
          width: 95px;
          height: 35px;
          font-family: 'Plavsky', sans-serif;
          font-weight: 700;
          font-size: 12px;
          line-height: 100%;
          color: #242424;
          border-radius: 5px;
        "
      >
          Registrar
        </button>
      </div>
    </form>
  </main>
</Layout>
